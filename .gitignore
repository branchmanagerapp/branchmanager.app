# Build intermediates: the bundler writes an unminified bm.bundle.vN.js next to
# the .min.js it actually ships. Only the .min.js is ever served by index.html.
# Committing the raw copy grew dist/ to 1 GB (145 stale versions) by v1217.
dist/bm.bundle.v*[0-9].js
!dist/bm.bundle.v*.min.js
